# Copy this file to .env and fill in your values.
# Replit secrets already inject DATABASE_URL, CLERK_*, SESSION_SECRET, and AI_INTEGRATIONS_* automatically.

# --- Polar (payments) ---
POLAR_ACCESS_TOKEN=your_polar_access_token_here
# Get from: https://polar.sh/settings → API keys

# --- OpenRouter (AI — optional, overrides Replit-managed OpenAI) ---
OPENROUTER_API_KEY=your_openrouter_key_here
# Get from: https://openrouter.ai/keys
# Model slug is configurable in the Admin dashboard (e.g. meta-llama/llama-3.3-70b-instruct:free)

# --- Admin ---
ADMIN_CLERK_ID=your_clerk_user_id_here
# Your Clerk user ID — makes you the admin of the dashboard.
# Find it at: https://dashboard.clerk.com → Users → click your user → copy User ID
